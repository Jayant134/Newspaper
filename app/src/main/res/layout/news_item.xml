<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">
    
    <data>
        <variable
            name="news"
            type="com.example.newspaper.model.News" />
        <variable
            name="clickHandler"
            type="com.example.newspaper.clickHandlers.NewsItemClickHandler" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:onClick="@{(view) -> clickHandler.onNewsItemClicked(view, news)}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:contentDescription="@string/image_of_news"
            bind:image="@{news.image}"
            android:id="@+id/newsImage"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="fitXY"
            android:layout_margin="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_medium"
            android:maxLines="1"
            android:text="@{news.title}"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:layout_margin="10dp"
            app:layout_constraintTop_toBottomOf="@+id/newsImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/descText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_light"
            android:maxLines="2"
            android:text="@{news.description}"
            android:textSize="18sp"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleText" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>